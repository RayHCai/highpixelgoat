# Copy to .env and fill in what you need. Every variable is optional.
# `npm run dev`, `npm start`, `npm run generate` and `npm run render` load .env if it exists.

# --- Claude (via the local Claude Code; see src/agent/config.ts) ---
# login (default): use the account `claude` is logged in to; ANTHROPIC_API_KEY is hidden from it.
# api-key: pass ANTHROPIC_API_KEY through to Claude Code, which bills it.
# Only set ANTHROPIC_API_KEY when you use api-key; with login it is never used.
# HPG_CLAUDE_AUTH=login
# ANTHROPIC_API_KEY=
# HPG_CLAUDE_PATH=
# HPG_MODEL=claude-opus-5-5
# HPG_OFFLINE=1

# --- Voice (see src/voice/tts.ts) ---
# HPG_TTS=edge            # elevenlabs | edge | sapi | none
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_VOICE_ID=
# HPG_EDGE_VOICE=
# HPG_SAPI_VOICE=

# --- Music and sound effects (see src/voice/music.ts, src/voice/sfx.ts) ---
# HPG_MUSIC_DIR=music
# HPG_MUSIC_VOLUME=0.22
# HPG_MUSIC_SOLO_VOLUME=0.6
# HPG_SFX_DIR=sfx

# --- Server ---
# PORT=5173
# HOST=127.0.0.1          # 0.0.0.0 opens the dashboard (and your Claude account) to the network
